# Copy this file to .env.docker and fill in the values.
# Do NOT commit .env.docker.

# --- Database (use simple letters and numbers in the password) ---
POSTGRES_USER=viora
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=viora
# The host name is "db" (the container name), not localhost
DATABASE_URL=postgresql+psycopg2://viora:change-me-to-something-long@db:5432/viora

# --- App secrets ---
GROQ_API_KEY=gsk_your_key_here
# Make one with:  openssl rand -hex 32
SECRET_KEY=put-a-long-random-string-here
